# ====== Salin file ini menjadi .env lalu isi nilainya ======

# Token bot dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=isi_token_dari_botfather

# Token LANGGANAN Claude Code, dibuat dengan perintah:  claude setup-token
# (butuh plan Pro/Max/Team/Enterprise). Berlaku ~1 tahun.
CLAUDE_CODE_OAUTH_TOKEN=isi_token_dari_claude_setup_token

# ID Telegram kamu (hanya ID ini yang boleh pakai bot). Pisahkan koma untuk banyak user.
# Kalau belum tahu ID-mu: jalankan bot, kirim pesan, bot akan menampilkan ID-mu.
ALLOWED_USER_IDS=123456789

# PENTING: JANGAN set ANTHROPIC_API_KEY di sini — kalau ada, ia akan dipakai
# menggantikan token langganan (dan bisa menimbulkan biaya API terpisah).

# --- Opsional (boleh dibiarkan default) ---

# Model: kosongkan untuk default langganan. Bisa diisi: sonnet / opus / haiku
CLAUDE_MODEL=

# Nama asisten
ASSISTANT_NAME=Asisten

# Zona waktu untuk pengingat (IANA tz names)
TIMEZONE=Asia/Jakarta
